.claude/

# Dev ledgers (logs/sessions/AGENTS/KNOWN-LIMITATIONS/recipe.md full edition) stay PRIVATE —
# the project's competitive knowledge base. Public docs are explicitly un-ignored below.
*.md
!README.md
!CONTRIBUTING.md
!CLA.md
!master-architecture.md
!architecture.md
!recipe-usage.md

# CI workflow stays LOCAL-ONLY (project decision 2026-07-19) — private dev artifact,
# not published to GitHub. File is kept locally; only untracked from the repo.
.github/workflows/ci.yml

.vs/

[Bb]in/
[Oo]bj/

packages/
*.nupkg

__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

*.log

dxf-research/
test/

Thumbs.db
.DS_Store

drawing-samples/

scratch/

# Build output is no longer vendored: it must be built locally against the installed
# SOLIDWORKS version (-p:SolidWorksApiDir=...), or a stale exe could be auto-started.
# bin/ and obj/ are ignored by the [Bb]in/ and [Oo]bj/ rules above.



# Customer-specific field-test material (numbers read from a third party's proprietary drawings): kept on disk
# for the developer, never published.
examples/*-rebuild/

# Scratch files the drawing tools write NEXT TO the user's source drawings (DWG/SLDDRW -> DXF exports, saved analyses)
*.dwg2dxf.dxf
*.slddrw2dxf.dxf
*.analysis-v*.json
.solidpilot/

# Remote gateway: secrets and runtime state
gateway/.env
gateway/.env.*
!gateway/.env.example
gateway/.vercel/
adapters/claude/.env
adapters/claude/.agent-secrets*
.pytest_cache/
