# Variables for the gateway. On Vercel set them with `vercel env add` (see README); for a local run copy to gateway/.env.

# Exact public https origin Claude will use (no trailing slash, no path), e.g. https://solidpilot.vercel.app
# This is the OAuth issuer and the token audience, so it must match the URL you give Claude.
GATEWAY_PUBLIC_URL=https://solidpilot.vercel.app

# The one password you type on the sign-in page when Claude asks to connect (long random value).
GATEWAY_OWNER_SECRET=

# Credentials the PC agent uses (OAuth client_credentials). Put the same pair in adapters/claude/.env.
AGENT_CLIENT_ID=solidworks-pc
AGENT_CLIENT_SECRET=

# Redis TCP URL (rediss://...). The Vercel Marketplace Redis/Upstash integration injects this for you
# as REDIS_URL or KV_URL; only set GATEWAY_REDIS_URL yourself for a local run.
# GATEWAY_REDIS_URL=redis://localhost:6379

# Optional
# GATEWAY_EXTRA_REDIRECT_URIS=            # comma-separated extra allowed OAuth redirect URIs
# GATEWAY_ALLOWED_ORIGINS=https://claude.ai,https://claude.com
# GATEWAY_CALL_TIMEOUT=200                # seconds to wait for the PC to answer one tool call (Claude's cap is 240)
