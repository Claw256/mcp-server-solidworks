# Add these to adapters/claude/.env to run `python agent.py` (the outbound relay to the remote gateway).
GATEWAY_URL=https://solidpilot.example.com
AGENT_CLIENT_ID=solidworks-pc
AGENT_CLIENT_SECRET=

# Optional
# AGENT_STAGING_DIR=C:\Users\you\SolidPilotStaging   # where uploaded files land / exports are fetched from
# AGENT_FILE_ROOTS=D:\CAD\Exports                     # extra folders get_file may read (os.pathsep separated)
# AGENT_MAX_FILE_MB=20
# AGENT_STAGING_TTL_HOURS=72
